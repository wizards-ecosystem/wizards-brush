# ============================================================================
#  The Wizard's Brush: single project-wide configuration
#  Copy to `.env` and fill in. Loaded by the backend and used to generate the
#  optional Remote GPU runner.
# ============================================================================

# ---- Hugging Face ----------------------------------------------------------
# Only needed for gated/private model weights. The starter model is ungated.
# Never paste this value into an issue, log, or generated runner attachment.
HF_TOKEN=

# ---- Model IDs (minimal starter profile; opt into more as needed) -----------
# Local image gen on the 16 GB card: Z-Image-Turbo (fast, fits with 4-bit + offload).
LOCAL_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
# Optional local "Quality" variant: Z-Image base (Apache-2.0, CFG model, more
# steps, richer detail). Enabling it adds roughly 20 GB to the model cache.
LOCAL_IMAGE_MODEL_HQ=
# Optional real-time comparison model: Apache-2.0 FLUX.2-klein-4B, roughly
# 13 GB VRAM on a 4070-class card and about 23 GB of cached files.
LOCAL_IMAGE_MODEL_KLEIN=
# Optional compatibility slots. Each appears only when explicitly set. They
# stay blank so the starter install remains one model instead of silently
# adding tens of gigabytes of downloads.
#   SDXL: any SDXL checkpoint (~6.9 GB bf16: no quantization or offload needed,
#            and the deepest LoRA ecosystem of anything here).
#   CHROMA: lodestones/Chroma1-HD, 8.9B de-distilled Flux-schnell, Apache-2.0.
#   FLUX: black-forest-labs/FLUX.1-dev, 12B. Gated: accept the licence on
#            huggingface.co and set HF_TOKEN, and note it is non-commercial.
LOCAL_IMAGE_MODEL_SDXL=
LOCAL_IMAGE_MODEL_CHROMA=
LOCAL_IMAGE_MODEL_FLUX=
# Remote 80 GB GPU image generation: Qwen-Image-2512 (Dec 2025 base; big realism/text upgrade).
# The best model that fits an A100 at full bf16 is FLUX.2-dev, at ~112 GB in bf16
# (64.4 transformer + 48.0 text encoder) and would have to be quantized to fit.
A100_IMAGE_MODEL=Qwen/Qwen-Image-2512
# Single-A100 quality challenger (MIT, official custom Pixel-DiT runner).
A100_IMAGE_MODEL_HIDREAM=HiDream-ai/HiDream-O1-Image
# Optional second 80 GB image model. Set it and the Remote GPU lane gets a model picker;
# leave it blank and the lane simply serves A100_IMAGE_MODEL. The A100 holds one
# image model at a time, so switching evicts and reloads.
A100_IMAGE_MODEL_ALT=
# Remote GPU image editing (1-3 input images).
QWEN_EDIT_MODEL=Qwen/Qwen-Image-Edit-2511
# Video on the Remote GPU. TI2V-5B is the best that doesn't tank the workflow
# (Wan 2.2 A14B is 126 GB per model, which is impractical to download each session.)
VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B-Diffusers
# Optional second video engine on the A100 (motion and I2V consistency).
# HunyuanVideo-1.5 is NOT an open-source model: its Tencent community license
# excludes the EU, UK, and South Korea and adds use/hosted-service conditions.
# Read docs/model-licenses.md and the current upstream license before opting in.
HUNYUAN_VIDEO_MODEL=
# Optional third video engine: LTX-2, the only open-weights family that generates
# synced audio. Leave EMPTY unless you have a runtime with a very large disk  -
# the checkpoints are 150-200 GB and will not fit on a standard 80 GB GPU
# alongside the image and Wan models. The server refuses with a clear error
# rather than starting a download that cannot finish.
LTX_VIDEO_MODEL=

# ---- Lightning "speed mode" LoRAs (Remote GPU) -----------------------------
# Model-matched 4-step adapters. Generation and editing are separate model
# families; leave either line empty to disable speed mode only for that lane.
IMAGE_LIGHTNING_LORA=lightx2v/Qwen-Image-2512-Lightning
EDIT_LIGHTNING_LORA=lightx2v/Qwen-Image-Edit-2511-Lightning
VIDEO_LIGHTNING_LORA=

# ---- Local image model performance (16 GB VRAM) ----------------------------
# Quantization for the local pipeline:
#   "nunchaku": SVDQuant INT4 (NVFP4 on Blackwell). Fastest by a wide margin and
#                small enough that the transformer stays resident, so no CPU
#                offload. Needs a separately reviewed wheel for your exact
#                torch/CUDA version and a published checkpoint for the model.
#                Setup never auto-installs native wheel code; see
#                `make install-nunchaku`.
#                NOTE: nunchaku 1.2.1's Z-Image kernel does not work with
#                diffusers >= 0.37 (it pins 0.36 in its own CI). Selecting it
#                runs a one-off preflight in a subprocess and falls back to 4bit
#                with a logged reason, so it is safe to set; it will simply
#                start working once upstream catches up.
#   "4bit": bitsandbytes NF4. Works everywhere, usually still needs offload.
#   "fp8": bitsandbytes 8-bit.
#   "none": plain bf16 (needs offload, slow).
LOCAL_QUANT=4bit
# CPU offload keeps a multi-billion-param DiT under 16 GB. Ignored under
# "nunchaku", which does not need it. Disable only on bigger GPUs.
LOCAL_OFFLOAD=true
# Preload the local model at startup so the first generation isn't a cold stall.
WARM_UP=true
# First-block cache threshold (0 = off). Helps at >=20 steps; leave off for Turbo.
# Shipped to the Remote GPU runner by `make remote-gpu`, so this one value
# governs both sides; previously the remote defaulted to 0.05 with no way to
# turn it off.
FBCACHE_THRESHOLD=0.0
# SageAttention backend on the Remote GPU pipes. This optional native extension
# must already be installed in the operator-controlled CUDA base environment.
ENABLE_SAGE_ATTENTION=false
# Emit a live preview thumbnail every N denoising steps (0 = off).
PREVIEW_EVERY=2

# ---- Gallery enrichment ------------------------------------------------------
# Auto-caption new assets (Florence-2 on CPU) and merge keyword tags for search.
ENRICH_CAPTIONS=true

# ---- Local ControlNet -------------------------------------------------------
# Structure-guided generation: canny edges, depth or pose from a source image.
# Verified working (canny) on the local Z-Image pipeline.
#
# REQUIRES LOCAL_OFFLOAD=false. With offload on, accelerate's hooks and the
# resident ControlNet disagree about device placement and CUDA aborts the whole
# process; the generator refuses to run rather than crash the backend. A 4-bit
# base model plus ControlNet fits comfortably in 16 GB without offload.
ENABLE_CONTROLNET=false
CONTROLNET_MODEL=alibaba-pai/Z-Image-Turbo-Fun-Controlnet-Union-2.1

# ---- Optional Remote GPU connection ----------------------------------------
# Paste the public HTTPS URL of the remote service. You can also set it in the
# app's Settings page at runtime; that value wins. The service must be on
# hardware you operate or are explicitly authorized to use. The generated
# worker is provider-neutral and runs from a shell or interactive notebook.
# See docs/remote-gpu.md.
REMOTE_GPU_BASE_URL=
# Shared secret sent as the `X-Gen-Secret` header. Must match the remote service.
# Leave empty and set a real value, for example `openssl rand -hex 16`, so a copied
# .env is never left authenticating with a guessable default.
REMOTE_GPU_SHARED_SECRET=

# ---- App / networking ------------------------------------------------------
# Localhost is the safe default. Set 0.0.0.0 only for a trusted LAN, and set
# API_TOKEN before allowing any untrusted device to reach the port.
HOST=127.0.0.1
PORT=8000
# Single shared output root for every generator.
OUTPUT_DIR=./output
# Project-local model stores. Absolute paths and paths escaping the checkout are
# rejected so a host environment variable cannot silently break containment.
LORA_DIR=./models/loras
HF_HOME=./models/huggingface
WEIGHTS_DIR=./models/weights
# Package caches, pinned tools, temporary files, and the optional browser profile.
RUNTIME_DIR=./.runtime
# Logging verbosity for the backend (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO
# Browser origins allowed to call /api/*, comma-separated. The Vite dev server
# is always allowed and the SPA is same-origin, so this is usually empty.
# Wildcards are ignored because this application may run without a token.
CORS_ORIGINS=
# Optional shared token for the API, live job events, and generated media
# (empty = auth disabled in loopback mode). The browser sends API headers and
# uses separate SameSite cookies scoped to /files and /api/jobs/ws for media
# elements and live events. Tokens never appear in URLs.
API_TOKEN=
# Embed replayable generation settings in exported images/videos. Disable for
# files that should carry no prompt, seed, model, or workflow details.
EMBED_METADATA=true
# Add the standardized AI-origin declaration independently of replay metadata.
EMBED_PROVENANCE=true

# Detect the GPU at startup, in a background thread, so the UI can report the
# device and pick hardware-appropriate defaults. Costs one torch import at
# startup; set false on a headless/CPU box to skip it entirely.
PROBE_DEVICE=true

# How ControlNet behaves when LOCAL_OFFLOAD is on.
#   refuse: fail early with a clear message (default, and safe)
#   rehook: reconcile device placement so both can run (experimental)
# The default is "refuse" because the failure mode is an uncatchable CUDA abort
# that kills the process. See backend/app/generators/offload.py.
CONTROLNET_OFFLOAD=refuse

# Notifications. Empty = off. Anything that accepts a POST works: ntfy, a Discord
# webhook, a Home Assistant automation, a script behind a one-line server.
#
# NOTIFY_IDLE_SECONDS is the debounce that makes "finished" mean something: the
# queue must stay empty for this long before it counts as done. Without it the
# hook fires between every pair of jobs.
NOTIFY_QUEUE_START_URL=
NOTIFY_QUEUE_IDLE_URL=
NOTIFY_JOB_DONE_URL=
NOTIFY_IDLE_SECONDS=5

# Rung 3 of the enrichment ladder: a CLIP vector per asset, enabling gallery
# search by meaning rather than by caption keyword. Off by default, it is a
# further model download and most of the value is in captions and tags.
ENRICH_EMBEDDINGS=false
EMBED_MODEL=openai/clip-vit-base-patch32

# Hardware profile: "auto" detects from VRAM, or name one explicitly
# (cpu, 8gb, 12gb, 16gb, 24gb). See backend/app/hardware.py.
HARDWARE_PROFILE=auto
